/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "files": [],
  "include": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.spec.json" },
    { "path": "./tsconfig.worker.json" }
  ],
  "compilerOptions": {
    "paths": {
      "@app/*": ["./src/app/*"],
      "@assets/*": ["./src/assets/*"],
      "@pages/*": ["./src/app/pages/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@abstract-classes/*": ["./src/app/shared/abstract-classes/*"],
      "@components/*": ["./src/app/shared/components/*"],
      "@directives/*": ["./src/app/shared/directives/*"],
      "@helpers/*": ["./src/app/shared/helpers/*"],
      "@interfaces/*": ["./src/app/shared/interfaces/*"],
      "@models/*": ["./src/app/shared/models/*"],
      "@resolvers/*": ["./src/app/shared/resolvers/*"],
      "@services/*": ["./src/app/shared/services/*"],
      "@validators/*": ["./src/app/shared/validators/*"]
    },
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
